{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/morning-brief",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/weekly-plan",
      "schedule": "0 11 * * 6"
    },
    {
      "path": "/api/cron/draft-followups",
      "schedule": "0 12 * * *"
    }
  ]
}
